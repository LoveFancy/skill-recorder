{
  "manifest_version": 3,
  "name": "技能录制器 · 浏览器采集",
  "version": "0.1.0",
  "description": "离线采集指定标签页的真实操作，加入技能录制器轨迹。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "技能录制器"
  }
}
